# SysCenter 环境变量示例
# 用法：复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，不会入库。
# 运行态后端通过环境变量读取这些配置（参见 backend/app/config.py）。

# ===== 后端网络 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8352

# ===== 数据库 PostgreSQL =====
PG_HOST=127.0.0.1
PG_PORT=5442
PG_USER=syscenter
PG_PASSWORD=请改为强密码
PG_DATABASE=syscenter

# ===== 缓存 Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6387
REDIS_DB=0

# ===== 运行数据目录（OTP 密钥 / 会话密钥落盘位置）=====
DATA_DIR=D:/WorkBuddy/SysCenter/backend/data

# ===== AI 网关（多模型，settings.ai_enabled=True 才启用）=====
AI_ENABLED=False
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 可选：AI 代理（如 http://127.0.0.1:1080）
AI_PROXY=
AI_ACTIVE=default

# ===== 飞书推送 / 机器人 =====
FEISHU_ENABLED=False
FEISHU_WEBHOOK=
FEISHU_SECRET=
FEISHU_DEFAULT_CHAT=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ADMIN_USERS=
FEISHU_TRUSTED_BOTS=

# ===== 自动化（n8n）=====
AUTOMATION_ENABLED=False
N8N_WEBHOOK_BASE=

# ===== 监控阈值 =====
HEALTH_CHECK_ENABLED=True
HEALTH_CHECK_INTERVAL=300
ALERT_CPU_THRESHOLD=90
ALERT_RAM_THRESHOLD=90
ALERT_DISK_THRESHOLD=90

# ===== 局域网 / 设备 =====
LAN_SUBNET=
NAS_HOST=
NAS_PORT=5000
TV_HOST=

# 说明：OTP 密钥与会话密钥默认自动生成并落盘到 DATA_DIR，无需手动设置；
# 生产环境建议固定 OTP_SECRET / SESSION_SECRET（填于此），以便重启后已签发令牌仍有效。
